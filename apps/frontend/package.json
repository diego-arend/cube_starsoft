{
  "name": "frontend",
  "version": "0.1.0",
  "prettier": "@repo/prettier-config",
  "scripts": {
    "dev": "next dev | pino-pretty",
    "predev": "pnpm --filter @turborepo/config build && pnpm --filter @turborepo/config generate-frontend-env",
    "prebuild": "pnpm --filter @turborepo/config build && [ -f ../../config.yaml ] && pnpm --filter @turborepo/config generate-frontend-env || true",
    "build": "next build",
    "start": "next start",
    "test": "vitest",
    "test:run": "vitest run",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,css,md}\"",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/api-logs": "0.57.0",
    "@grafana/faro-web-sdk": "1.12.3",
    "@grafana/faro-web-tracing": "1.12.3",
    "@opentelemetry/core": "1.30.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.57.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.57.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.57.0",
    "@opentelemetry/instrumentation": "0.57.0",
    "@opentelemetry/instrumentation-http": "0.57.0",
    "@opentelemetry/instrumentation-pino": "0.46.1",
    "@opentelemetry/resources": "1.30.0",
    "@opentelemetry/sdk-logs": "0.57.0",
    "@opentelemetry/sdk-metrics": "1.30.0",
    "@opentelemetry/sdk-node": "0.57.0",
    "@opentelemetry/sdk-trace-base": "1.30.0",
    "@opentelemetry/sdk-trace-web": "1.30.0",
    "@opentelemetry/semantic-conventions": "1.40.0",
    "@opentelemetry/auto-instrumentations-node": "0.55.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.57.0",
    "@opentelemetry/instrumentation-aws-sdk": "0.50.0",
    "@opentelemetry/instrumentation-grpc": "0.57.0",
    "@opentelemetry/instrumentation-ioredis": "0.49.0",
    "@opentelemetry/instrumentation-nestjs-core": "0.45.0",
    "@opentelemetry/instrumentation-pg": "0.53.0",
    "@opentelemetry/instrumentation-undici": "0.5.0",
    "@turborepo/config": "workspace:*",
    "@turborepo/database": "workspace:*",
    "@turborepo/observability": "workspace:*",
    "@turborepo/ui": "workspace:^",
    "@types/uuid": "^9.0.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.294.0",
    "next": "16.0.7",
    "next-auth": "5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.69.0",
    "socket.io-client": "^4.8.3",
    "uuid": "^11.1.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.9",
    "three": "^0.176.0"
  },
  "dependenciesMeta": {
    "@turborepo/config": {}
  },
  "devDependencies": {
    "@repo/prettier-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^20",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^9",
    "jsdom": "^27.4.0",
    "pino-pretty": "^9.0.0",
    "postcss": "^8.4.32",
    "@types/three": "^0.176.0",
    "prettier": "^3.4.2",
    "tailwindcss": "4",
    "typescript": "6.0.0-dev.20251210",
    "vitest": "^4.0.16"
  }
}
