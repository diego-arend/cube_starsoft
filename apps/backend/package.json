{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "prettier": "@repo/prettier-config",
  "scripts": {
    "prebuild": "echo 'Skipping nested workspace build — use root build for full workspace: pnpm run build, or build this app directly: pnpm -C apps/backend run build'",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,json,md}\" \"test/**/*.{ts,tsx,js,json,md}\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "fix:lint": "pnpm run lint:fix",
    "start": "nest start",
    "predev": "echo 'Skipping nested workspace predev — use root predev: pnpm run predev'",
    "dev": "nest start --watch | pino-pretty",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:cov": "vitest --coverage",
    "test:debug": "vitest --run",
    "test:e2e": "echo \"e2e tests disabled\"",
    "studio": "langgraphjs dev"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/static": "^9.0.0",
    "@langchain/core": "^1.1.17",
    "@langchain/langgraph": "^1.1.2",
    "@nestjs/cache-manager": "^3.1.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^3.1.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.1.12",
    "@nestjs/swagger": "^11.2.3",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.12",
    "@opentelemetry/api": "^1.9.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@turborepo/assistant": "workspace:*",
    "@turborepo/bucket": "workspace:*",
    "@turborepo/config": "workspace:*",
    "@turborepo/database": "workspace:*",
    "@turborepo/email": "workspace:*",
    "@turborepo/llm": "workspace:*",
    "@turborepo/logging": "workspace:*",
    "@turborepo/messaging": "workspace:*",
    "@turborepo/observability": "workspace:^",
    "@turborepo/rate-limit": "workspace:*",
    "@turborepo/redis": "workspace:*",
    "bcryptjs": "^2.4.3",
    "cache-manager": "^7.2.7",
    "dotenv": "^16.1.4",
    "fastify": "^5.6.2",
    "file-type": "16.5.4",
    "jsonwebtoken": "^9.0.0",
    "pdfjs-dist": "4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "uuid": "^11.1.0",
    "zod": "^4.1.13",
    "zod-to-json-schema": "^3.25.0"
  },
  "devDependencies": {
    "@langchain/langgraph-cli": "^1.1.11",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@repo/prettier-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/jsonwebtoken": "^9.0.1",
    "@types/node": "^22.10.7",
    "@types/uuid": "^9.0.1",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.18.0",
    "pino-pretty": "^9.0.0",
    "prettier": "^3.4.2",
    "typescript": "6.0.0-dev.20251210",
    "typescript-eslint": "^8.20.0",
    "vitest": "^4.0.16"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
