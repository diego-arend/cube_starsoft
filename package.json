{
  "name": "turborepo_saas",
  "private": true,
  "prettier": "@repo/prettier-config",
  "scripts": {
    "prebuild": "pnpm generate-envs",
    "build": "turbo run build",
    "build:packages": "turbo run build --filter './packages/**'",
    "predev": "pnpm generate-envs && turbo run build --filter './packages/*' --filter '!apps/**'",
    "dev": "turbo run dev",
    "generate-envs": "pnpm env:generate:frontend && pnpm env:generate:backend && pnpm env:generate:worker",
    "env:generate:frontend": "pnpm --filter @turborepo/config generate-frontend-env",
    "env:generate:backend": "pnpm --filter @turborepo/config generate-backend-env",
    "env:generate:worker": "pnpm --filter @turborepo/config generate-worker-env",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "format": "prettier --write \"*.{json,md,yaml,yml}\" \"scripts/**/*.{js,ts}\" && turbo run format",
    "check-types": "turbo run check-types",
    "test": "turbo run test -- --watch",
    "test:ci": "turbo run test -- --run",
    "test:all": "turbo run test -- --run --reporter=verbose",
    "test:all:coverage": "turbo run test -- --run --coverage && pnpm -s coverage:merge:all && pnpm -s coverage:print",
    "check-declarations": "node ./scripts/check-declarations.js",
    "test:packages": "pnpm --filter './packages/*' test -- --run",
    "test:packages:watch": "pnpm --filter './packages/*' test",
    "test:packages:coverage": "pnpm --filter './packages/*' test -- --run --coverage && pnpm -s coverage:merge:packages && pnpm -s coverage:print coverage/packages-lcov.info",
    "test:backend": "pnpm --filter backend test -- --run",
    "test:backend:coverage": "pnpm --filter backend test -- --run --coverage && pnpm -s coverage:merge:backend && pnpm -s coverage:print coverage/backend-lcov.info",
    "test:frontend": "pnpm --filter frontend test -- --run",
    "test:frontend:coverage": "pnpm --filter frontend test -- --run --coverage && pnpm -s coverage:merge:frontend && pnpm -s coverage:print coverage/frontend-lcov.info",
    "coverage:merge:all": "node ./scripts/merge-lcov.js",
    "coverage:merge:packages": "mkdir -p coverage && find packages -name lcov.info -not -path '*/node_modules/*' | xargs cat > coverage/packages-lcov.info",
    "coverage:merge:frontend": "mkdir -p coverage && find apps/frontend -name lcov.info -not -path '*/node_modules/*' | xargs cat > coverage/frontend-lcov.info",
    "coverage:print": "node ./scripts/coverage-summary.js",
    "test:ci:coverage": "turbo run test -- --run --coverage && pnpm -s coverage:merge:all && pnpm -s coverage:print",
    "coverage:merge:backend": "mkdir -p coverage && find apps/backend -name lcov.info -not -path '*/node_modules/*' | xargs cat > coverage/backend-lcov.info",
    "migrate:generate": "pnpm --filter @turborepo/database run migrate:generate --",
    "migrate:run": "pnpm --filter @turborepo/database run migrate:run",
    "seed:users": "pnpm --filter @turborepo/database run seed:users",
    "docker:up": "docker compose -p cube-docker -f docker/docker-compose-dev.yml up -d --build",
    "docker:down": "docker compose -p cube-docker -f docker/docker-compose-dev.yml down",
    "docker:up:test-load": "sh scripts/docker-up-test-load.sh",
    "docker:down:test-load": "docker compose -f docker/test-load/docker-compose-test-load.yml down",
    "docker:up:ngrok": "sh scripts/docker-up-ngrok.sh",
    "docker:down:ngrok": "docker compose -f docker/ngrok/docker-compose-ngrok.yml down",
    "validate:config": "pnpm --filter @turborepo/config run validate",
    "clean": "rm -rf node_modules/.cache/turbo && find . -type d \\( -name \"node_modules\" \\) -prune -o -type d \\( -name \"dist\" -o -name \".turbo\" -o -name \".next\" \\) -exec rm -rf {} +",
    "knip": "knip"
  },
  "devDependencies": {
    "@types/uuid": "^9.0.1",
    "@vitest/coverage-istanbul": "^4.0.16",
    "jsdom": "^27.4.0",
    "knip": "^5.83.1",
    "lcov-parse": "^1.0.0",
    "prettier": "^3.6.2",
    "tsconfig-paths": "^4.2.0",
    "turbo": "^2.6.1",
    "typescript": "6.0.0-dev.20251210",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "@langchain/textsplitters": "^1.0.1",
    "@opentelemetry/instrumentation": "0.57.0",
    "@opentelemetry/instrumentation-amqplib": "0.46.1",
    "uuid": "^11.1.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "@opentelemetry/api": "1.9.0",
      "@opentelemetry/api-logs": "0.57.0",
      "@opentelemetry/core": "1.30.0",
      "@opentelemetry/instrumentation": "0.57.0",
      "@opentelemetry/instrumentation-http": "0.57.0",
      "@opentelemetry/resources": "1.30.0",
      "@opentelemetry/sdk-logs": "0.57.0",
      "@opentelemetry/sdk-metrics": "1.30.0",
      "@opentelemetry/sdk-node": "0.57.0",
      "@opentelemetry/sdk-trace-base": "1.30.0",
      "@opentelemetry/sdk-trace-node": "1.30.0",
      "@opentelemetry/sdk-trace-web": "1.30.0",
      "@opentelemetry/semantic-conventions": "1.40.0",
      "@opentelemetry/exporter-logs-otlp-http": "0.57.0",
      "@opentelemetry/exporter-metrics-otlp-http": "0.57.0",
      "@opentelemetry/exporter-trace-otlp-http": "0.57.0",
      "@opentelemetry/exporter-logs-otlp-grpc": "0.57.0",
      "@opentelemetry/exporter-metrics-otlp-grpc": "0.57.0",
      "@opentelemetry/exporter-trace-otlp-grpc": "0.57.0",
      "@opentelemetry/instrumentation-pino": "0.46.1",
      "@opentelemetry/instrumentation-undici": "0.5.0",
      "import-in-the-middle": "^2.0.2",
      "require-in-the-middle": "^8.0.1"
    }
  }
}
