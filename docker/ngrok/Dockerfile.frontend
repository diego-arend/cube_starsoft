FROM node:22-slim AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable
WORKDIR /app

# Stage 1: Prune the workspace
FROM base AS pruner
RUN pnpm add -g turbo
COPY . .
RUN turbo prune frontend --docker --out-dir=out

# Stage 2: Build the application
FROM base AS builder
# Next.js build often needs env vars at build time. 
ENV NEXT_TELEMETRY_DISABLED=1
# Production build hint to skip heavy dev tools
ENV NODE_ENV=production

# Install turbo in builder stage
RUN pnpm add -g turbo

COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/pnpm-lock.yaml .
# Use --frozen-lockfile for deterministic builds and only devDependencies as needed by build
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile --prod=false

# NEXT_PUBLIC_* vars are inlined by webpack at build time — they must be
# declared as ARG and promoted to ENV so `next build` can embed them.
# These are public values (no secrets). All server-side secrets (NEXTAUTH_URL,
# AUTH_SECRET, OTEL keys, etc.) are injected at runtime via docker-compose env_file.
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_SOCKET_URL
ARG NEXT_PUBLIC_FARO_URL
ARG NEXT_PUBLIC_APP_VERSION
ARG NEXT_PUBLIC_ENV
ARG NEXT_PUBLIC_OTEL_ENABLED
ARG NEXT_PUBLIC_OTEL_SERVICE_NAME
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_SOCKET_URL=$NEXT_PUBLIC_SOCKET_URL
ENV NEXT_PUBLIC_FARO_URL=$NEXT_PUBLIC_FARO_URL
ENV NEXT_PUBLIC_APP_VERSION=$NEXT_PUBLIC_APP_VERSION
ENV NEXT_PUBLIC_ENV=$NEXT_PUBLIC_ENV
ENV NEXT_PUBLIC_OTEL_ENABLED=$NEXT_PUBLIC_OTEL_ENABLED
ENV NEXT_PUBLIC_OTEL_SERVICE_NAME=$NEXT_PUBLIC_OTEL_SERVICE_NAME

COPY --from=pruner /app/out/full/ .
# Remove generic config and any .env files — NEXT_PUBLIC_* vars come from build ARGs
# above; server-side secrets are injected at runtime by docker-compose (env_file).
# Removing .env* prevents Next.js from reading local secrets during `next build`.
RUN rm -f config.yaml config.example.yaml && \
    find . -name ".env*" -delete
COPY turbo.json turbo.json

# Building
RUN turbo run build --filter=frontend

# Stage 3: Production image
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Use node user for security
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs
USER nextjs

COPY --from=builder --chown=nextjs:nodejs /app/apps/frontend/public ./apps/frontend/public

# Automatically leverage output traces to reduce image size
# https://nextjs.org/docs/advanced-features/output-file-tracing
COPY --from=builder --chown=nextjs:nodejs /app/apps/frontend/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/frontend/.next/static ./apps/frontend/.next/static
# .env is NOT copied — server-side vars are provided at runtime by docker-compose.

# Fix: Next.js standalone output (pnpm) does not create accessible symlinks for
# transitive deps of @opentelemetry/instrumentation (require-in-the-middle,
# import-in-the-middle, shimmer, semver). Without these, the OTel HTTP
# instrumentation cannot patch node:http and http_server metrics go missing.
RUN for pkg in import-in-the-middle require-in-the-middle semver shimmer; do \
      dir=$(ls /app/node_modules/.pnpm/ | grep "^${pkg}@" | head -1); \
      if [ -n "$dir" ]; then \
        ln -sf "/app/node_modules/.pnpm/${dir}/node_modules/${pkg}" "/app/apps/frontend/node_modules/${pkg}"; \
        echo "Linked ${pkg} -> ${dir}"; \
      fi; \
    done

EXPOSE 3000
ENV PORT=3000

CMD ["node", "apps/frontend/server.js"]
