{
  "name": "@turborepo/assistant",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "prettier": "@repo/prettier-config",
  "scripts": {
    "build": "tsup",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest --coverage",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@langchain/core": "^1.1.17",
    "@langchain/langgraph": "^1.1.2",
    "@turborepo/database": "workspace:*",
    "@turborepo/llm": "workspace:*",
    "@turborepo/logging": "workspace:*",
    "@turborepo/redis": "workspace:*",
    "uuid": "^11.1.0",
    "zod": "^4.1.13"
  },
  "peerDependencies": {
    "@nestjs/common": "*",
    "@nestjs/config": "*"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/prettier-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^3.1.0",
    "@opentelemetry/api": "^1.9.0",
    "@types/node": "^22.10.7",
    "@vitest/coverage-v8": "^4.0.18",
    "tsup": "^8.0.2",
    "typescript": "6.0.0-dev.20251210",
    "vitest": "^4.0.16"
  }
}
