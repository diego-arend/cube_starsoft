{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../packages/typescript-config/nestjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "dist",
    "rootDir": "src",
    "declarationDir": "dist",
    "paths": {
      "@turborepo/database": ["src"],
      "@turborepo/*": ["../*/dist", "../*/src"]
    },
    "incremental": false
  },
  "include": ["src", "eslint.config.mjs"],
  "exclude": [
    "**/*.spec.ts",
    "**/*.test.ts",
    "src/test/**",
    "test/**",
    "dist",
    "node_modules",
    "coverage"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
