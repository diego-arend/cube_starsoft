{
  "name": "@turborepo/email",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/templates"
  ],
  "prettier": "@repo/prettier-config",
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "lint": "eslint . --ext .ts --fix",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,json,md}\"",
    "send:test": "ts-node -r tsconfig-paths/register ./src/cli/send-test-email.ts"
  },
  "dependencies": {
    "@turborepo/config": "workspace:*",
    "handlebars": "^4.7.7",
    "minimist": "^1.2.8",
    "nodemailer": "^6.9.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/minimist": "^1.2.2",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^6.4.7",
    "ts-node": "^10.9.1",
    "tsup": "^8.0.1",
    "typescript": "6.0.0-dev.20251210",
    "vitest": "^4.0.16"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0"
  }
}
