{
  "extends": "../../packages/typescript-config/nestjs.json",
  "compilerOptions": {
    "incremental": false,
    "baseUrl": ".",
    "outDir": "dist",
    "rootDir": "src",
    "declarationDir": "dist",
    "paths": {
      "@turborepo/rate-limit": ["src"],
      "@turborepo/*": ["../*/dist", "../*/src"]
    }
  },
  "include": ["src", "eslint.config.mjs"],
  "exclude": [
    "**/*.spec.ts",
    "**/*.test.ts",
    "src/test/**",
    "test/**",
    "dist",
    "node_modules",
    "coverage"
  ]
}
